{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "services/api",
      "framework": "go"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "vite",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/admin/(.*)", "destination": "/admin/index.html" }]
    },
    "web": {
      "root": "apps/web",
      "buildCommand": "pnpm build",
      "outputDirectory": "build/client",
      "rewrites": [{ "source": "/(.*)", "destination": "/__spa-fallback.html" }]
    }
  },
  "redirects": [{ "source": "/admin", "destination": "/admin/", "permanent": false }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/healthz", "destination": { "service": "api" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
